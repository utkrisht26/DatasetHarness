<mxfile host="app.diagrams.net" agent="AgenticDatasetHarness/architecture-generator" version="24.0.0" type="device"><diagram id="adh-arch" name="Agentic Dataset Harness"><mxGraphModel dx="2400" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="10" value="Agentic Dataset Generation Harness" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="700" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="11" value="Discovery-first: the user gives a goal, NOT sources. The system finds where the data lives (datasets &gt; web &gt; synthesis), then curates it into a verified dataset." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="500" y="64" width="1700" height="24" as="geometry" /></mxCell><mxCell id="100" value="Job Spec&#10;(goal + target record schema +&#10;verifiability tier + limits;&#10;NO sources required)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=2;fontColor=#3730A3;fontStyle=1;fontSize=13;align=center;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="220" height="150" as="geometry" /></mxCell><mxCell id="200" value="ENGINE A — DISCOVERY + ACQUISITION  (deepagents / LangGraph)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=2;fontColor=#075985;fontStyle=1;fontSize=15;align=center;verticalAlign=top;spacingTop=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="320" y="130" width="940" height="470" as="geometry" /></mxCell><mxCell id="201" value="Source Discovery Agent&#10;goal -&gt; aspects -&gt; diverse queries  •  eva