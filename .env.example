# Copy this file to .env and replace only the values you need.
# The CLI loads .env at startup; importing adh never loads it automatically.

# Discovery model used by `adh discover`, `adh run`, `adh loop`, and `adh serve`.
ADH_DISCOVERY_MODEL=openai:gpt-4o-mini

# Optional OpenAI-compatible gateway shared by factory-built chat models.
# Leave both blank to use the selected provider's native endpoint and key variable.
ADH_LLM_BASE_URL=
ADH_LLM_API_KEY=

# Deployment-wide Engine B overrides (comma-separated, cheap/frontier order).
ADH_GENERATOR_MODELS=
ADH_JUDGE_MODELS=

# Provider-native credentials consumed by LangChain when their provider is selected.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Discovery and media provider credentials.
TAVILY_API_KEY=
PEXELS_API_KEY=
OPENVERSE_API_KEY=

# Gateway security and browser access. Generate a strong ADH_API_KEY for remote binds.
ADH_API_KEY=
ADH_CORS_ORIGINS=http://localhost:3000

# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
ADH_LOG_LEVEL=INFO
