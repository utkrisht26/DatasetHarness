{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brilo.ai/adh/schemas/video_caption_record.schema.json",
  "title": "Video Caption Record",
  "description": "Licensed video clip + caption prompt for image-to-video fine-tuning (Tier 3 hybrid: deterministic media-probe gate, then LLM jury on the caption).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "job_id",
    "split",
    "input",
    "output",
    "media",
    "source_channel",
    "model_id",
    "prompt_hash",
    "generated_at",
    "pipeline_step",
    "verifiability_tier"
  ],
  "properties": {
    "record_id": { "type": "string" },
    "job_id": { "type": "string" },
    "split": { "type": "string", "enum": ["train", "validation", "test"] },
    "input": { "type": "string", "minLength": 1 },
    "output": { "type": "string", "minLength": 1 },
    "source_channel": { "type": "string", "enum": ["datasets", "web", "synthesis", "media"] },
    "source_url": { "type": ["string", "null"] },
    "source_license": { "type": "string" },
    "source_sha256": { "type": ["string", "null"] },
    "derived_from": { "type": "array", "items": { "type": "string" } },
    "model_id": { "type": "string" },
    "prompt_hash": { "type": "string" },
    "system_prompt_hash": { "type": ["string", "null"] },
    "generation_params": { "type": "object" },
    "generated_at": { "type": "string" },
    "pipeline_step": { "type": "string" },
    "verifiability_tier": { "type": "integer", "enum": [1, 2, 3] },
    "verifier_result": { "type": ["object", "null"] },
    "judge_scores": { "type": ["object", "null"] },
    "judge_models": { "type": "array", "items": { "type": "string" } },
    "dedup_cluster_id": { "type": ["string", "null"] },
    "is_duplicate": { "type": "boolean" },
    "contamination_flag": { "type": "boolean" },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "language": { "type": "string" },
    "task_category": { "type": ["string", "null"] },
    "cost_usd": { "type": "number", "minimum": 0 },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "bytes", "format"],
      "properties": {
        "role": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
        "bytes": { "type": "integer", "minimum": 1 },
        "duration_s": { "type": ["number", "null"], "minimum": 0 },
        "width": { "type": ["integer", "null"], "minimum": 1 },
        "height": { "type": ["integer", "null"], "minimum": 1 },
        "fps": { "type": ["number", "null"] },
        "format": { "type": "string" },
        "attribution": { "type": ["string", "null"] }
      }
    }
  },
  "x-verifier": {
    "kind": "media_probe",
    "entry": "adh.verifiers.media:check_media",
    "min_duration_s": 2.0,
    "max_duration_s": 30.0,
    "min_width": 720
  }
}
